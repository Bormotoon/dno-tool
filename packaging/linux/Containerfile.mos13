FROM docker.io/library/ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
       binutils ca-certificates cmake cpio file ffmpeg gzip libasound2t64 \
       libdbus-1-3 libegl1 libgl1 libopengl0 libpulse0 libva2 patchelf \
       libx11-xcb1 libxcb-cursor0 libxcb-icccm4 libxcb-keysyms1 \
       libxcb-render-util0 libxcb-xinerama0 libxcb-xkb1 libxkbcommon-x11-0 \
       ninja-build python3 python3-dev python3-venv rpm tar \
    && rm -rf /var/lib/apt/lists/*

COPY packaging/linux/*.py packaging/linux/*.sh packaging/linux/sources.json /opt/recipe/
COPY requirements.txt scripts/ensure_qt.py /opt/recipe/app/

RUN mkdir -p /opt/dno/wheels /opt/manifest \
    && python3 -m venv /opt/dno/.venv \
    && /opt/dno/.venv/bin/python -m pip install --upgrade pip setuptools wheel \
    && /opt/dno/.venv/bin/python -m pip install -r /opt/recipe/app/requirements.txt pyinstaller \
    && /opt/dno/.venv/bin/python /opt/recipe/app/ensure_qt.py --requirements /opt/recipe/app/requirements.txt \
    && QT_QPA_PLATFORM=offscreen QT_MEDIA_BACKEND=ffmpeg /opt/dno/.venv/bin/python /opt/recipe/verify_environment.py \
    && /usr/bin/dpkg-query -W -f='${Package}=${Version}\n' > /opt/native-packages.txt \
    && /opt/dno/.venv/bin/python -m pip freeze --all > /opt/manifest/requirements.lock \
    && /opt/dno/.venv/bin/python /opt/recipe/write_manifest.py

COPY packaging/media/ /opt/recipe/media/

RUN set -eu; \
    python3 -c "import urllib.request; urllib.request.urlretrieve('https://github.com/mamba-org/micromamba-releases/releases/download/2.9.0-0/micromamba-linux-64', '/tmp/micromamba')"; \
    echo '366cd9cd8be14df1ab8ed50352a82111082a36686b2d389fdb79a92c3fafb3e3  /tmp/micromamba' | sha256sum -c -; \
    chmod 755 /tmp/micromamba; \
    MAMBA_ROOT_PREFIX=/tmp/mamba-root CONDA_PKGS_DIRS=/cache/conda-pkgs /tmp/micromamba create -y -p /tmp/qt-media -c conda-forge --strict-channel-priority \
        'ffmpeg=9.0.2=gpl_h584299d_905' 'python=3.12' 'av=19.0.2' 'qt6-main=6.12.0' 'qt6-multimedia=6.12.0'; \
    MAMBA_ROOT_PREFIX=/tmp/mamba-root CONDA_PKGS_DIRS=/cache/conda-pkgs /tmp/micromamba list -p /tmp/qt-media --explicit > /opt/manifest/mos13-multimedia.lock; \
    /opt/dno/.venv/bin/python /opt/recipe/media/linux.py \
        --prefix /tmp/qt-media --runtime /opt/qt-media-runtime \
        --pyside /opt/dno/.venv/lib/python3.12/site-packages/PySide6 --copy-pyav --replace-qt; \
    rm -rf /tmp/qt-media /tmp/mamba-root /tmp/micromamba /root/.cache

ENV LD_LIBRARY_PATH="/opt/dno/.venv/lib/python3.12/site-packages/PySide6/Qt/lib:/opt/qt-media-runtime/lib"

RUN /opt/dno/.venv/bin/python /opt/recipe/media/bundle.py manifest \
    && QT_QPA_PLATFORM=offscreen QT_MEDIA_BACKEND=ffmpeg \
    /opt/dno/.venv/bin/python /opt/recipe/verify_environment.py \
    && QT_QPA_PLATFORM=offscreen QT_MEDIA_BACKEND=ffmpeg \
       /opt/dno/.venv/bin/python /opt/recipe/media/qt_codecs.py

ENV PATH="/opt/dno/.venv/bin:${PATH}" \
    QT_QPA_PLATFORM=offscreen \
    QT_MEDIA_BACKEND=ffmpeg \
    DNO_SKIP_DEPENDENCY_INSTALL=1 \
    DNO_BUILD_VENV=/opt/dno/.venv

RUN apt-get update && apt-get install -y --no-install-recommends xvfb xauth \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
CMD ["bash", "scripts/build_rpm.sh"]
